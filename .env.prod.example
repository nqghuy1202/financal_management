# Copy file này thành .env.prod trên VPS rồi điền giá trị THẬT (.env.prod đã bị gitignore, không commit):
#   cp .env.prod.example .env.prod
#
# Sinh giá trị random an toàn bằng: openssl rand -hex 32
# Dùng file/mật khẩu KHÁC với debt-crusher dù chạy chung VPS — không tái sử dụng secrets giữa 2 app.

CORS_ORIGINS=https://finance.hlcompany.id.vn

# App từ chối khởi động nếu để trống hoặc còn chứa "change-me"/"dev-secret".
JWT_SECRET=change-me

BLUEPRINT_DB_DATABASE=financal
BLUEPRINT_DB_USERNAME=financal_app
BLUEPRINT_DB_PASSWORD=change-me-app-password
BLUEPRINT_DB_ROOT_PASSWORD=change-me-root-password
