# Sao chép thành .env rồi chỉnh giá trị: cp .env.example .env
# Được nạp tự động qua godotenv/autoload và bởi docker-compose.

# Cổng phục vụ app (API + frontend tĩnh)
PORT=8080

# Origin cho phép CORS (phân tách bằng dấu phẩy). Khi phục vụ FE từ chính app
# thì cùng origin nên có thể để nguyên; thêm http://localhost:5173 khi chạy Vite dev.
CORS_ORIGINS=http://localhost:8080,http://localhost:5173

# Khóa ký JWT (ĐỔI trong production)
JWT_SECRET=change-me

# MySQL (dùng cho docker-compose và khi nối API thật)
BLUEPRINT_DB_HOST=localhost
BLUEPRINT_DB_PORT=3306
BLUEPRINT_DB_DATABASE=financal
BLUEPRINT_DB_USERNAME=app
BLUEPRINT_DB_PASSWORD=change-me
BLUEPRINT_DB_ROOT_PASSWORD=change-me-root
