# Cổng phục vụ app (API + frontend tĩnh)
PORT=8080

CORS_ORIGINS=http://localhost:8080,http://localhost:5173

# Khóa ký JWT — BẮT BUỘC đổi giá trị này (kể cả chạy local). App sẽ từ chối
# khởi động nếu để trống hoặc còn chứa "change-me"/"dev-secret".
# Tạo một chuỗi mạnh bằng: openssl rand -hex 32
JWT_SECRET=change-me

# MySQL
BLUEPRINT_DB_HOST=localhost
BLUEPRINT_DB_PORT=3306
BLUEPRINT_DB_DATABASE=financal
BLUEPRINT_DB_USERNAME=app
BLUEPRINT_DB_PASSWORD=change-me
BLUEPRINT_DB_ROOT_PASSWORD=change-me-root
