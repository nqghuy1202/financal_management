# Sao chép file này thành .env rồi chỉnh theo máy của bạn:
#   cp .env.example .env
# File .env không được commit (đã nằm trong .gitignore).

# ---------------------------------------------------------------------
# Hạ tầng chạy bằng docker compose
# ---------------------------------------------------------------------
POSTGRES_USER=fintrack
POSTGRES_PASSWORD=fintrack
POSTGRES_DB=fintrack
# Dùng 5433 thay vì 5432 để không tranh cổng với PostgreSQL cài trực tiếp
# trên máy (nếu có). Đổi giá trị này thì phải sửa cả postgres.port trong
# config/local.yaml cho khớp.
POSTGRES_PORT=5433

REDIS_PORT=6379

KAFKA_PORT=9092
KAFKA_UI_PORT=8081

MAILHOG_SMTP_PORT=1025
MAILHOG_UI_PORT=8025

# ---------------------------------------------------------------------
# Ứng dụng Go
# ---------------------------------------------------------------------
# Quyết định file cấu hình được nạp: config/<APP_ENV>.yaml
APP_ENV=local

# Mọi khoá trong file yaml đều override được bằng biến môi trường theo
# quy tắc: FM_ + đường dẫn khoá, dấu chấm đổi thành gạch dưới, viết hoa.
#   postgres.password  ->  FM_POSTGRES_PASSWORD
#   server.port        ->  FM_SERVER_PORT
#   jwt.secret         ->  FM_JWT_SECRET
#
# Ở production, bắt buộc đặt các biến sau thay vì ghi vào file yaml:
# FM_POSTGRES_PASSWORD=
# FM_REDIS_PASSWORD=
# FM_JWT_SECRET=

# Dùng cho lệnh migrate của goose
GOOSE_DRIVER=postgres
GOOSE_DBSTRING=postgres://fintrack:fintrack@localhost:5433/fintrack?sslmode=disable
GOOSE_MIGRATION_DIR=./migrations
